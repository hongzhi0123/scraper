{
    "url": "http://localhost:5500/sites/site_FMA/page1.html",
    "page": {
        "tables": [{
            "config": {
                "type": "divs",
                "itemSelector": "div.card",
                "columns": [
                    {
                        "selector": "div.card-body li:nth-of-type(3) ul li:first-of-type",
                        "key": "id"
                    },
                    {
                        "selector": "h3 button span",
                        "key": "name"
                    },
                    {
                        "selector": "div.card-body li:nth-of-type(2)",
                        "key": "address"
                    },
                    {
                        "selector": "div.print-view-button-wrap a",
                        "detailLink": true,
                        "key": "detail"
                    },
                    {
                        "selector": "div.modal-body h5:contains('Deutschland') + p",
                        "key": "roles"
                    }
                ],
                "detail": {
                    "parser": "generic",
                    "tables": [{
                        "key": "services",
                        "config": {
                            "type": "table",
                            "tableSelector": "#zone_en_europe div[id^='zone_succ_DE'] table[summary^='List of activities']:first",
                            "rowFilter": {
                                "selector": "td:first-child img",
                                "attr": "alt",
                                "value": "Ticked activity"
                            },
                            "columns": [
                                {
                                    "index": -1
                                }
                            ]
                        }
                    }]
                }
            },
            "pagination": {
                "nextPageSelector": "a:contains('Next page')"
            }
        }]
    }
}